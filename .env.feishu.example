# 复制为 .env.feishu 并填写（勿提交 Git）
# 独立多维表格: https://xxx.feishu.cn/base/bascnXXXX?table=tblXXXX
# Wiki 内嵌表格: https://xxx.feishu.cn/wiki/J63XXXX?table=tblXXXX
#   → APP_TOKEN = wiki/ 后面那段；TABLE_ID = table= 后面那段

FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxx
FEISHU_BITABLE_APP_TOKEN=J63xxxxxxxx
FEISHU_BITABLE_TABLE_ID=tblxxxxxxxx
FEISHU_BITABLE_TABLE_SUCCESS_ID=tblxxxxxxxx
FEISHU_BITABLE_TABLE_FAILURE_ID=tblxxxxxxxx
FEISHU_BITABLE_TABLE_ROUTINE_ID=tblxxxxxxxx
FEISHU_OWNER=
BLOCK_RESULT_ROOT=/mnt/g/02block_result
