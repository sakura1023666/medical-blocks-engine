+incidence_sensitivity_as_yes_no_chr <- function(x) {
+  xs <- trimws(as.character(x))
+  yes <- incidence_sensitivity_yes_tokens()
+  no  <- incidence_sensitivity_no_tokens()
+  xs[xs %in% yes] <- "Yes"
+  xs[xs %in% no]  <- "No"
